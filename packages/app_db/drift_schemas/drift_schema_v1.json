    {
      "name": "feeds",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feeds\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"position\" INTEGER NOT NULL, \"created_at\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "feed_sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_sources\" (\"feed_id\" INTEGER NOT NULL REFERENCES feeds (id) ON DELETE CASCADE, \"chat_id\" INTEGER NOT NULL, \"position\" INTEGER NOT NULL, \"added_at\" INTEGER NOT NULL, PRIMARY KEY (\"feed_id\", \"chat_id\"));"
        }
      ]
    },
    {
      "name": "feed_read_marks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"feed_read_marks\" (\"feed_id\" INTEGER NOT NULL REFERENCES feeds (id) ON DELETE CASCADE, \"chat_id\" INTEGER NOT NULL, \"last_read_message_id\" INTEGER NOT NULL, PRIMARY KEY (\"feed_id\", \"chat_id\"));"
        }
      ]
    },
    {
      "name": "watched_channels",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"watched_channels\" (\"chat_id\" INTEGER NOT NULL, \"title\" TEXT NOT NULL, \"username\" TEXT NULL, PRIMARY KEY (\"chat_id\"));"
        }
      ]
    },
    {
      "name": "settings",
